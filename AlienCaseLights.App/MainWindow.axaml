<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AlienCaseLights.App.ViewModels"
        xmlns:controls="using:AlienCaseLights.App.Controls"
        x:Class="AlienCaseLights.App.MainWindow"
        Title="Alien Case Lights"
        Icon="/Assets/tray.png"
        Width="980" Height="860" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0E1116">
    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#171C24" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ColorEditorViewModel">
            <Border Classes="panel" Width="290" Margin="0,0,12,12">
                <StackPanel Spacing="12">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="46" Height="20" CornerRadius="4" Background="{Binding Preview}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    </DockPanel>
                    <controls:ColorWheel Width="240" Height="240" HorizontalAlignment="Center" Hue="{Binding Hue, Mode=TwoWay}" Saturation="{Binding Saturation, Mode=TwoWay}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Brightness, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="220,*" Margin="20">
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Effects}"
                 SelectedItem="{Binding SelectedEffect, Mode=TwoWay}"
                 Background="Transparent"
                 FontSize="14">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="1" Margin="20,0,0,0">
            <StackPanel Spacing="12">
                <Border Classes="panel">
                    <ItemsControl ItemsSource="{Binding Zones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="3"
                                        Padding="0"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectZoneCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="6">
                                        <Border Height="64" CornerRadius="8" BorderThickness="2" Background="{Binding Live}" BorderBrush="{Binding Outline}" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Foreground="#8B97A5" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <WrapPanel>
                    <ContentControl Content="{Binding Primary}" IsVisible="{Binding ShowPrimary}" />
                    <ContentControl Content="{Binding Secondary}" IsVisible="{Binding ShowSecondary}" />
                    <ContentControl Content="{Binding ZoneEditor}" IsVisible="{Binding ShowZones}" />
                </WrapPanel>

                <Border Classes="panel">
                    <StackPanel Spacing="10">
                        <StackPanel IsVisible="{Binding ShowSpeed}" Spacing="4">
                            <TextBlock Text="Speed" FontWeight="SemiBold" />
                            <Slider Minimum="0.1" Maximum="4" Value="{Binding Speed, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="Brightness" FontWeight="SemiBold" />
                        <Slider Minimum="0.05" Maximum="1" Value="{Binding Brightness, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#8B97A5" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <CheckBox Content="Lights on" IsChecked="{Binding LightsOn, Mode=TwoWay}" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

